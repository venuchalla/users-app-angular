{
  "name": "users-app",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "start:local": "ng serve --configuration local",
    "start:local:proxy": "ng serve --configuration local --proxy-config proxy.conf.json",
    "start:development": "ng serve --configuration development",
    "start:qa": "ng serve --configuration qa",
    "start:production": "ng serve --configuration production",
    "start:local:csr": "ng serve --configuration local-csr",
    "start:local:ssr": "ng serve --configuration local-ssr",
    "start:production:csr": "ng serve --configuration production-csr",
    "start:production:ssr": "ng serve --configuration production-ssr",
    "start:csr": "npm run start:local:csr",
    "start:ssr": "npm run start:local:ssr",
    "build": "ng build",
    "build:local": "ng build --configuration local",
    "build:development": "ng build --configuration development",
    "build:qa": "ng build --configuration qa",
    "build:production": "ng build --configuration production",
    "build:local:csr": "ng build --configuration local,csr --output-path=dist/users-app --base-href /",
    "build:local:ssr": "ng build --configuration local,ssr --output-path=dist/users-app --base-href /",
    "build:production:csr": "ng build --configuration production,csr --output-path=dist/users-app --base-href /users-app-angular/",
    "build:production:ssr": "ng build --configuration production,ssr --output-path=dist/users-app --base-href /users-app-angular/",
    "build:csr": "npm run build:production:csr",
    "build:ssr": "npm run build:production:ssr",
    "build:ghpages": "npm run build:production:csr",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "serve:ssr:users-app": "node dist/users-app/server/server.mjs",
    "start:mock": "node mock-backend/index.mjs",
    "start:mock:watch": "nodemon --watch mock-backend --ext js,json --exec \"node mock-backend/index.mjs\"",
    "start:dev": "concurrently \"npm run start:mock\" \"npm run start:local\""
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^21.2.7",
    "@angular/cdk": "^21.2.5",
    "@angular/common": "^21.2.7",
    "@angular/compiler": "^21.2.7",
    "@angular/core": "^21.2.7",
    "@angular/forms": "^21.2.7",
    "@angular/material": "^21.2.5",
    "@angular/platform-browser": "^21.2.7",
    "@angular/platform-browser-dynamic": "^21.2.7",
    "@angular/platform-server": "^21.2.7",
    "@angular/router": "^21.2.7",
    "@angular/ssr": "^21.2.6",
    "@ngrx/effects": "^21.1.0",
    "@ngrx/entity": "^21.1.0",
    "@ngrx/router-store": "^21.1.0",
    "@ngrx/store": "^21.1.0",
    "@ngrx/store-devtools": "^21.1.0",
    "@node-saml/node-saml": "^5.2.0",
    "bootstrap": "^5.3.3",
    "express": "^5.1.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.1"
  },
  "devDependencies": {
    "@angular/build": "^21.2.6",
    "@angular/cli": "^21.2.6",
    "@angular/compiler-cli": "^21.2.7",
    "@types/express": "^5.0.1",
    "@types/jasmine": "~5.1.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.17.19",
    "angular-cli-ghpages": "^3.1.0",
    "concurrently": "^10.0.3",
    "jasmine-core": "~5.1.0",
    "jest": "^30.3.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "typescript": "~5.9.3"
  }
}
